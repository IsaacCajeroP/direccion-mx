# Copia este archivo a ".env" y ajusta los valores.
# NUNCA subas tu archivo ".env" real al repositorio (ya esta en .gitignore).

# --- Puerto del servidor Express -------------------------------------------
PORT=3000

# --- Opcion 1: cadena de conexion completa ----------------------------------
# Usala cuando el proveedor de base de datos te da una URL lista
# (Render, Railway, Supabase, ElephantSQL, Heroku, etc).
# Si defines DATABASE_URL, las variables DB_* de abajo se ignoran.
# DATABASE_URL=postgres://usuario:password@host:5432/catalogos_mx

# --- Opcion 2: variables sueltas (uso local recomendado) --------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=catalogos_mx

# --- SSL ---------------------------------------------------------------------
# Ponlo en "true" cuando el proveedor de base de datos en la nube requiera
# conexiones SSL (la mayoria de los servicios gratuitos, como Render, lo
# requieren). En local normalmente se deja en "false".
DB_SSL=false
